namespace Bai15
{
    public partial class Form1 : Form
    {
        private DomainUpDown dudColor;
        private NumericUpDown nudSize;
        private Label lblSampleText;

        public Form1()
        {
            InitializeComponent();

            // Thiết lập Form
            this.Text = "Text Formatting Application";
            this.Size = new Size(500, 300);
            this.StartPosition = FormStartPosition.CenterScreen;
            this.BackColor = Color.White;

            // Tạo Label cho DomainUpDown
            Label lblColor = new Label();
            lblColor.Text = "Color:";
            lblColor.Location = new Point(20, 20);
            lblColor.Size = new Size(50, 25);
            lblColor.Font = new Font("Arial", 10);
            lblColor.AutoSize = true;
            this.Controls.Add(lblColor);

            // Tạo DomainUpDown cho màu sắc
            dudColor = new DomainUpDown();
            dudColor.Name = "dudColor";
            dudColor.Items.Add("Green");
            dudColor.Items.Add("Red");
            dudColor.Items.Add("Blue");
            dudColor.Items.Add("Black");
            dudColor.SelectedIndex = 0;
            dudColor.Location = new Point(80, 20);
            dudColor.Size = new Size(150, 30);
            dudColor.Font = new Font("Arial", 10);
            dudColor.SelectedItemChanged += DudColor_SelectedItemChanged;
            this.Controls.Add(dudColor);

            // Tạo Label cho NumericUpDown
            Label lblSize = new Label();
            lblSize.Text = "Font Size:";
            lblSize.Location = new Point(20, 70);
            lblSize.Size = new Size(60, 25);
            lblSize.Font = new Font("Arial", 10);
            lblSize.AutoSize = true;
            this.Controls.Add(lblSize);

            // Tạo NumericUpDown cho kích thước font
            nudSize = new NumericUpDown();
            nudSize.Name = "nudSize";
            nudSize.Value = 16;
            nudSize.Minimum = 8;
            nudSize.Maximum = 72;
            nudSize.Location = new Point(80, 70);
            nudSize.Size = new Size(150, 30);
            nudSize.Font = new Font("Arial", 10);
            nudSize.ValueChanged += NudSize_ValueChanged;
            this.Controls.Add(nudSize);

            // Tạo Label hiển thị Sample Text
            lblSampleText = new Label();
            lblSampleText.Name = "lblSampleText";
            lblSampleText.Text = "Sample Text";
            lblSampleText.Location = new Point(80, 130);
            lblSampleText.Size = new Size(300, 80);
            lblSampleText.Font = new Font("Arial", 16);
            lblSampleText.ForeColor = Color.Green;
            lblSampleText.BorderStyle = BorderStyle.FixedSingle;
            lblSampleText.TextAlign = ContentAlignment.MiddleCenter;
            this.Controls.Add(lblSampleText);
        }

        private void DudColor_SelectedItemChanged(object sender, EventArgs e)
        {
            DomainUpDown dud = (DomainUpDown)sender;
            try
            {
                lblSampleText.ForeColor = Color.FromName(dud.Text);
            }
            catch
            {
                lblSampleText.ForeColor = Color.Black;
            }
        }

        private void NudSize_ValueChanged(object sender, EventArgs e)
        {
            NumericUpDown nud = (NumericUpDown)sender;
            lblSampleText.Font = new Font(lblSampleText.Font.FontFamily, (float)nud.Value);
        }

        private void Form1_Load(object sender, EventArgs e)
        {

        }
    }
}
